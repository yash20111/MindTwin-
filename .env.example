# Public site URL used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://mindtwin.app

# Supabase (optional). When both are set, waitlist signups are stored in Supabase.
# Without them, signups are logged to the server console (local dev only).
# NEVER expose the service role key to the browser — it is only read in server code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
